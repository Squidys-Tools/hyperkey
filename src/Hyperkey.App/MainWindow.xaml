<ui:FluentWindow
    x:Class="Hyperkey.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Hyperkey"
    Icon="/Hyperkey.App;component/Assets/favicon.ico"
    Width="560"
    Height="700"
    MinWidth="460"
    MinHeight="560"
    ResizeMode="CanResize"
    ExtendsContentIntoTitleBar="True"
    WindowStartupLocation="CenterScreen"
    UseLayoutRounding="True">
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="TitleBar"
            Grid.Row="0"
            Title=""
            Background="{DynamicResource ApplicationBackgroundBrush}"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            ButtonsBackground="{DynamicResource ApplicationBackgroundBrush}"
            ButtonsForeground="{DynamicResource TextFillColorPrimaryBrush}"
            ShowClose="True"
            ShowMaximize="True"
            ShowMinimize="True" />

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            HorizontalContentAlignment="Stretch">
            <StackPanel
                Margin="{StaticResource Hyperkey.ContentMargin}"
                HorizontalAlignment="Stretch">

                <!-- Header: title + enabled control. Badge mirrors toggle state. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock
                            Style="{StaticResource Hyperkey.TitleText}"
                            Text="Hyperkey" />
                        <TextBlock
                            Margin="0,2,0,0"
                            Style="{StaticResource Hyperkey.SubtitleText}"
                            Text="One key becomes a new modifier layer." />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Border
                            x:Name="EnabledBadge"
                            Margin="0,0,12,0"
                            Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                            BorderBrush="{DynamicResource SystemFillColorSuccessBrush}"
                            Focusable="False"
                            IsHitTestVisible="False"
                            Style="{StaticResource Hyperkey.EnabledBadge}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse
                                    x:Name="EnabledDot"
                                    Width="8"
                                    Height="8"
                                    VerticalAlignment="Center"
                                    Fill="{DynamicResource SystemFillColorSuccessBrush}" />
                                <TextBlock
                                    x:Name="EnabledStateText"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="On" />
                            </StackPanel>
                        </Border>
                        <ui:ToggleSwitch
                            x:Name="EnabledToggle"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Hyperkey enabled"
                            Click="EnabledToggle_Click"
                            ToolTip="Enable or disable Hyperkey" />
                    </StackPanel>
                </Grid>

                <!-- Primary status area: combination + helper + hook chip -->
                <Border Style="{StaticResource Hyperkey.StatusPanel}">
                    <StackPanel>
                        <TextBlock
                            x:Name="StatusText"
                            Style="{StaticResource Hyperkey.StatusTitleText}" />
                        <TextBlock
                            x:Name="StatusDescription"
                            Margin="0,6,0,0"
                            Style="{StaticResource Hyperkey.BodyText}" />
                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                            <Border x:Name="StatusChip" Style="{StaticResource Hyperkey.StatusChip}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse
                                        x:Name="StatusDot"
                                        Width="8"
                                        Height="8"
                                        VerticalAlignment="Center"
                                        Fill="{DynamicResource SystemFillColorSuccessBrush}" />
                                    <TextBlock
                                        x:Name="StatusChipText"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource Hyperkey.StatusChipText}"
                                        Text="RUNNING" />
                                </StackPanel>
                            </Border>
                            <TextBlock
                                x:Name="StatusHookText"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource Hyperkey.CaptionText}"
                                Text="Hook status: Running" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Trigger: segmented control replacing the combo box -->
                <StackPanel Margin="0,20,0,0">
                    <TextBlock Style="{StaticResource Hyperkey.SectionHeading}" Text="TRIGGER KEY" />
                    <Border Style="{StaticResource Hyperkey.SegmentedContainer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton
                                x:Name="CapsLockTriggerButton"
                                Grid.Column="0"
                                AutomationProperties.Name="Trigger key Caps Lock"
                                Checked="TriggerOption_Checked"
                                Content="Caps Lock"
                                GroupName="Trigger"
                                Style="{StaticResource Hyperkey.SegmentedOption}" />
                            <RadioButton
                                x:Name="ScrollLockTriggerButton"
                                Grid.Column="1"
                                AutomationProperties.Name="Trigger key Scroll Lock"
                                Checked="TriggerOption_Checked"
                                Content="Scroll Lock"
                                GroupName="Trigger"
                                Style="{StaticResource Hyperkey.SegmentedOption}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Output modifiers: keycap toggles -->
                <StackPanel Margin="0,16,0,0">
                    <TextBlock Style="{StaticResource Hyperkey.SectionHeading}" Text="OUTPUT MODIFIERS" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            x:Name="ControlModifierCheckBox"
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="Output modifier Control"
                            Click="OutputModifierCheckBox_Click"
                            Content="Ctrl"
                            Style="{StaticResource Hyperkey.KeycapToggle}"
                            ToolTip="Include Ctrl in the Hyperkey output" />
                        <CheckBox
                            x:Name="AltModifierCheckBox"
                            Grid.Column="1"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="Output modifier Alt"
                            Click="OutputModifierCheckBox_Click"
                            Content="Alt"
                            Style="{StaticResource Hyperkey.KeycapToggle}"
                            ToolTip="Include Alt in the Hyperkey output" />
                        <CheckBox
                            x:Name="ShiftModifierCheckBox"
                            Grid.Column="2"
                            AutomationProperties.Name="Output modifier Shift"
                            Click="OutputModifierCheckBox_Click"
                            Content="Shift"
                            Style="{StaticResource Hyperkey.KeycapToggle}"
                            ToolTip="Include Shift in the Hyperkey output" />
                    </Grid>
                    <TextBlock
                        x:Name="ModifierSelectionHintText"
                        Margin="0,6,0,0"
                        Style="{StaticResource Hyperkey.CaptionText}"
                        Text="Choose one or more modifiers." />
                </StackPanel>

                <!-- Startup: divider + toggle rows, no cards -->
                <Border Style="{StaticResource Hyperkey.SectionDivider}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hyperkey.SectionHeading}" Text="STARTUP" />
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="Launch at login" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Style="{StaticResource Hyperkey.CaptionText}"
                                    Text="Start Hyperkey in the background when you sign in." />
                            </StackPanel>
                            <ui:ToggleSwitch
                                x:Name="LaunchToggle"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Launch at login"
                                Click="LaunchToggle_Click" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="Launch to tray" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Style="{StaticResource Hyperkey.CaptionText}"
                                    Text="Keep the settings window closed when Hyperkey starts." />
                            </StackPanel>
                            <ui:ToggleSwitch
                                x:Name="LaunchToTrayToggle"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Launch to tray"
                                Click="LaunchToTrayToggle_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    x:Name="RecoveryBanner"
                    Margin="0,20,0,0"
                    Padding="14"
                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                    BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Hyperkey.Radius.Banner}"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="RecoveryText"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        TextWrapping="Wrap" />
                </Border>

                <!-- Diagnostics: visually secondary -->
                <Border Style="{StaticResource Hyperkey.SectionDivider}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Hyperkey.SectionHeading}" Text="DIAGNOSTICS" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Top"
                                Style="{StaticResource Hyperkey.CaptionText}">
                                <Run Text="Hook status: " /><Run x:Name="DiagnosticStatusText" FontWeight="SemiBold" />
                            </TextBlock>
                        </Grid>
                        <TextBlock
                            x:Name="DiagnosticMessageText"
                            Margin="0,10,0,0"
                            Style="{StaticResource Hyperkey.CaptionText}"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="DiagnosticCopyStatusText"
                            Margin="0,10,0,0"
                            Style="{StaticResource Hyperkey.CaptionText}"
                            Visibility="Collapsed" />
                        <TextBlock
                            Margin="0,10,0,0"
                            Style="{StaticResource Hyperkey.CaptionText}"
                            Text="Elevated applications are unsupported in this MVP. Other keyboard remappers may also interfere." />
                        <WrapPanel Margin="0,12,0,0" Orientation="Horizontal">
                            <ui:Button
                                Margin="0,0,8,8"
                                Padding="14,7"
                                AutomationProperties.Name="Restart keyboard hook"
                                Click="RestartHook_Click"
                                Content="Restart hook" />
                            <ui:Button
                                Margin="0,0,8,8"
                                Padding="14,7"
                                AutomationProperties.Name="Emergency disable Hyperkey"
                                BorderBrush="{DynamicResource SystemFillColorCriticalBrush}"
                                Click="EmergencyDisable_Click"
                                Content="Emergency disable"
                                Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                            <ui:Button
                                Margin="0,0,0,8"
                                Padding="14,7"
                                AutomationProperties.Name="Copy diagnostic details"
                                Click="CopyDiagnostics_Click"
                                Content="Copy details" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,20,0,8">
                    <TextBlock
                        x:Name="VersionText"
                        Style="{StaticResource Hyperkey.CaptionText}"
                        Text="Version" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource Hyperkey.CaptionText}"
                        Text="The keyboard hook runs only while Hyperkey is enabled." />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
